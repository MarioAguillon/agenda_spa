# ENTORNO Y PUERTO
NODE_ENV=development
PORT=3000
TIMEZONE=America/Bogota

# BASE DE DATOS POSTGRESQL (TDB Cloud / Local)
DATABASE_URL="postgresql://usuario:password@localhost:5432/claudia_santana_nails?schema=public"

# SEGURIDAD Y JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_por_un_valor_aleatorio_de_64_caracteres
JWT_EXPIRES_IN=12h

# TELEFONO DEL SALON
SALON_PHONE_NUMBER=573184642772

# WHATSAPP CLOUD API (OPCIONAL EN V1)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# WEB PUSH VAPID KEYS (PWA NOTIFICATIONS)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@claudiasantananails.com

# CLIENT URL (CORS)
CLIENT_URL=http://localhost:4200
